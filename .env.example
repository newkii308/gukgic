# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gukgic?schema=public"

# Redis (Upstash or Self-hosted)
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="gukgic-super-secret-jwt-key-change-in-production-min-32-chars"
NODE_ENV="development"
PORT="3000"

# Cloudflare R2 Media Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Sentry (Error Tracking)
SENTRY_DSN=""
